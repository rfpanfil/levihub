FROM python:3.14-alpine

WORKDIR /app

# Instala os compiladores C no Alpine para não quebrar o bcrypt, cryptography e libsql
RUN apk add --no-cache gcc musl-dev libffi-dev g++ python3-dev

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Para desenvolvimento, vamos montar o diretório local via docker-compose
# O CMD inicia o Uvicorn com hot-reload ativo
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
